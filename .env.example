# planovac / F0-03
# Tento soubor slouzi jako vychozi sablona pro lokalni konfiguraci.
# Pro lokalni vyvoj ho zkopirujte do .env.local a doplnte konkretni hodnoty.

# Povinna identifikace prostredi v aplikaci.
# Povolené hodnoty: local, preview, production
NEXT_PUBLIC_APP_ENV=local

# Zakladni verejna adresa aplikace pro odkazy, metadata a smoke overeni.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Verejne hodnoty pro budouci napojeni na Supabase.
# Jejich prakticke pouziti bude dopsano v navazujicich fazich F0-04 a F1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side secret pro operace, ktere nesmi bezet v klientovi.
# Nikdy ho nevkladejte do klientoveho kodu ani do verejnych promennych.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Adresa pouzita pro budoucí smoke kontroly.
SMOKE_BASE_URL=http://localhost:3000

# Poznamka:
# VERCEL_ENV, VERCEL_URL a VERCEL_GIT_COMMIT_SHA typicky dodava Vercel automaticky.
# GITHUB_SHA typicky dodava GitHub Actions automaticky.
